    "@fontsource/instrument-serif": "^5.3.0",
    "@fontsource/zen-old-mincho": "^5.3.0",
    "cmdk": "^1.1.1",
    "cobe": "^2.0.1",
    "lenis": "^1.3.26",
    "motion": "^13.4.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-zoom-pan-pinch": "^4.2.0",
